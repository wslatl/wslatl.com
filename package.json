{
  "name": "WSLATL-SITE",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
