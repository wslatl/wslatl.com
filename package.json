{
  "name": "WSLATL-SITE",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/keep-old-assets.mjs save",
    "build": "next build",
    "postbuild": "node scripts/keep-old-assets.mjs restore",
    "start": "next start",
    "serve": "node scripts/serve.mjs",
    "admin:hash": "node platform/admin/hash-password.mjs",
    "partners:cards": "node scripts/partner-cards.mjs",
    "home:card": "node scripts/home-card.mjs",
    "brand:images": "node scripts/brand-kit.mjs",
    "lint": "oxlint && eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:http": "vitest run --mode http",
    "check": "npm run platform:check && npm run i18n:check && npm run lint && npm run test && npm run build && npm run scan:build && npm run test:http && npm run typecheck",
    "lint:fix": "oxlint --fix --ignore-pattern \"platform/**\" --ignore-pattern scripts/serve.mjs --ignore-pattern \"scripts/updater/**\" && eslint . --fix --ignore-pattern \"platform/**\" --ignore-pattern scripts/serve.mjs --ignore-pattern \"scripts/updater/**\"",
    "scan:build": "node scripts/scan-build.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "platform:sync": "node platform/tools/sync.mjs",
    "platform:check": "node platform/tools/check.mjs",
    "i18n:check": "node platform/tools/i18n-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-oxlint": "^1.93.0",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "@next/eslint-plugin-next": {
      "fast-glob": "npm:tinyglobby@^0.2.17"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "use-intl": "4.14.9",
    "icu-minify": "4.14.9"
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  },
  "browserslist": [
    "chrome >= 114",
    "edge >= 114",
    "firefox >= 128",
    "safari >= 17",
    "ios_saf >= 17"
  ]
}
