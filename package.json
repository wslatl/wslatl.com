      "fast-glob": "npm:tinyglobby@^0.2.17"
    }
  },
  "allowScripts": {
    "sharp": true,
    "unrs-resolver": true
  },
  "browserslist": [
    "chrome >= 114",
    "edge >= 114",
    "firefox >= 128",
    "safari >= 17",
    "ios_saf >= 17"
