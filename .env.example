# Settings for the admin at /admin, the only part of the site that reads any.
# Copy this file to .env in the server's folder (beside package.json) and fill
# it in. Never commit .env; it is in .gitignore. Values need no quotes, and
# must not contain a $ (Next expands it). README, "Admin and updates", has the
# whole setup.
#
# The admin stays off, answering 404 everywhere, until the first three are
# set. The server log says which one is missing.

# The admin password, hashed. Run `npm run admin:hash` on your own computer,
# in a copy of this repository, and paste the line it prints.
ADMIN_PASSWORD_HASH=

# Signs the login cookie. At least 32 characters; `npm run admin:hash` prints
# a fresh one. Changing it, or the password, logs everyone out.
ADMIN_SESSION_SECRET=

# A fine-grained GitHub token, used to read the releases and download them:
#   Resource owner: wslatl
#   Repository access: Only select repositories, wslatl/wslatl.com
#   Repository permissions: Contents, Read-only (Metadata, Read-only comes with it)
# Nothing else. When it expires, the dashboard says GitHub refused the token.
GITHUB_TOKEN=

# The repository whose releases the site installs (README, "Releasing"). The
# updater installs published releases only, never a branch.
GITHUB_REPO=wslatl/wslatl.com

# Leave unset. Only for testing the updater against a stand-in for GitHub
# running on this same machine (http://127.0.0.1:...).
# GITHUB_API_URL=

# Leave unset on Pterodactyl, which sets SERVER_PORT to the server's port.
# `npm run serve` listens on SERVER_PORT, then PORT, then 3000.
# PORT=3000
